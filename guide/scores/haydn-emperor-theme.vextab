staff viola { name "Viola" shortName "Vla."
  key G clef alto
  :q G3 :q rest |
  :h rest slur { :q D4[staccato] :q D4[staccato] } |
  slur { :8 F#3 :8 A3 :q G3 } :h rest |
  slur { :q A3 :q B3 :q E4 :q G3 } |
  slur { :h F#3 :q G3 } :q rest |
  :h rest slur { :q D4[staccato] :q D4[staccato] } |
  slur { :8 F#3 :8 A3 :q G3 } :h rest |
  slur { :q A3 :q B3 :q E4 :q G3 } |
  :h F#3 :q D4 :q D4 |
  :q D4 :q rest slur { :q A3 :8 G3 :8 B3 } |
  :q D4 :q rest slur { :q D4 :8 E4 :8 F#4 |
  :q G4 } :q G3 :q E4 slur { :8 E4 :8 D4 } |
  :h D4[fermata] :h (G3 D4) |
  slur { :8. E4 :16 F#4 } :q G4 :q. G4 :8 G4 |
  :q (D4[staccato] A4) :q (D4[staccato] B4) :h D4 |
  slur { :q G3 :8 E4 :8 C4 } slur { :q B3 :q C4 } |
  :h B3 :h (G3 D4) |
  slur { :8. E4 :16 F#4 } :q G4 :q. G4 :8 G4 |
  :q (D4[staccato] A4) :q (D4[staccato] B4) :h D4 |
  slur { :q G3 :8 E4 :8 C4 } slur { :q B3 :q C4 } |
  fragment { :h B3 bar double }
}

staff cello { name "Violoncello" shortName "Vc."
  key G clef bass
  :q G3 :q rest |
  :h rest slur { :q F#3 :q G3 } |
  :q D3 :q G2 :h rest |
  slur { :q D3 :q G3 :q C3 :q C#3 } |
  slur { :h D3 :q G3 } :q rest |
  :h rest slur { :q F#3 :q G3 } |
  :q D3 :q G2 :h rest |
  slur { :q D3 :q G3 :q C3 :q C#3 } |
  :h D3 :q D3 :q D3 |
  :q D3 :q rest :q D3 :q D3 |
  :q D3 :q rest slur { :q B2 :8 C3 :8 D3 } |
  :h E3 :q A2 :q A2 |
  :h D3[fermata] :q. B3 :8 B3 |
  :q C4 :q G3 :q. C3 :8 G3 |
  :q D3 :q G3 :h C3 |
  slur { :q B2 :q C3 :q D3 } :q D3[staccato] |
  :h G2 :q. B3 :8 B3 |
  :q C4 :q G3 :q. C3 :8 G3 |
  :q D3 :q G3 :h C3 |
  slur { :q B2 :q C3 :q D3 } :q D3[staccato] |
  fragment { :h G2 bar double }
}
