// Haydn, Op. 76 No. 3, II. Poco adagio, cantabile. Theme, pickup through bar 20.
// OpenScore CC0 transcription 20428156. See issues/197/README.md for the edition and editorial choices.
meter cut
pickup 1/2
play { tempo 80 }

staff violin_i { name "Violin I" shortName "Vln. I"
  key G clef treble
  slur { :q. G4 :8 A4 |
  :q B4 :q A4 :q C5 :q B4 } |
  slur { :8 A4 :8 F#4 :q G4 } slur { :q E5 :q D5 |
  :q C5 :q B4 } slur { :q A4 :8 B4 :8 G4 } |
  :h D5 slur { :q. G4 :8 A4 |
  :q B4 :q A4 :q C5 :q B4 } |
  slur { :8 A4 :8 F#4 :q G4 } slur { :q E5 :q D5 |
  :q C5 :q B4 } slur { :q A4 :8 B4 :8 G4 } |
  :h D5 slur { :q A4 :q B4 |
  :8 A4 :8 F#4 :q D4 } slur { :q C5 :q B4 |
  :8 A4 :8 F#4 :q D4 } slur { :q D5 :q C5 |
  :q. B4 } :8 B4 :q C#5 slur { :8 C#5 :8 D5 } |
  :h D5[fermata] slur { :q. G5 :8 F#5 |
  :8 F#5 :8 E5 :q D5 } slur { :q. E5 :8 D5 |
  :8 D5 :8 C5 :q B4 } slur { :q. A4 :16 B4 :16 C5 } |
  slur { :8 D5 :8 E5 :8 C5 :8 A4 } :q G4 slur { :8 A4 :8 G4 } |
  :h G4 slur { :q. G5 :8 F#5 |
  :8 F#5 :8 E5 :q D5 } slur { :q. E5 :8 D5 |
  :8 D5 :8 C5 :q B4 } slur { :q. A4 :16 B4 :16 C5 } |
  slur { :8 D5 :8 E5 :8 C5 :8 A4 } slur { :q G4 :8 A4 :8 G4 } |
  fragment { :h G4 bar double }
}

staff violin_ii { name "Violin II" shortName "Vln. II"
  key G clef treble
  slur { :q. B3 :8 D4 |
  :q G4 :q F#4 :q A4 :q G4 } |
  slur { :q C4 :q B3 } slur { :q C5 :q B4 |
  :q F#4 :q G4 } slur { :h E4 |
  :h D4 } slur { :q. B3 :8 D4 |
  :q G4 :q F#4 :q A4 :q G4 } |
  slur { :q C4 :q B3 } slur { :q C5 :q B4 |
  :q F#4 :q G4 } slur { :h E4 |
  :h D4 } slur { :q F#4 :q G4 |
  :q F#4 } :q rest slur { :q F#4 :q G4 |
  :q F#4 } :q rest slur { :q B4 :q A4 |
  :h. G4 } slur { :8 G4 :8 F#4 } |
  :h F#4[fermata] :q. (G3 G4) :8 G4 |
  slur { :8. G4 :16 A4 } :q B4 slur { :q. C5 :8 B4 } |
  slur { :q F#4 :q G4 } :q. F#4 slur { :16 G4 :16 A4 } |
  slur { :q G4 :8 E4 :8 A4 } slur { :q G4 :q F#4 } |
  :h G4 :q. (G3 G4) :8 G4 |
  slur { :8. G4 :16 A4 } :q B4 slur { :q. C5 :8 B4 } |
  slur { :q F#4 :q G4 } slur { :q. F#4 :16 G4 :16 A4 } |
  slur { :q G4 :8 E4 :8 A4 } slur { :q G4 :q F#4 } |
