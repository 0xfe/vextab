# Bend one whole tone, hold it, then release.
alias fullbend="bend +2 rise=1/2 hold=3/4 release=1"
measureNumbers on
play { performer blues }
meter 4/4
guitar {
  tuning dropD capo 0
  voice melody stem up tabStems on {
    volta 2 {
      mark "A" :q 3/2 2/3 :h (3/2 2/3) |
      :q 5/2 7/3 :h (5/2 7/3) |
      :h (7/3[tie] 5/2[tie]) :q 3/2 2/3 |
      :h (5/2 7/3[fullbend]) :q 3/2 2/3 |
      mark "B" :q 1/2 x/3 :h 2/3 |
      :q 3/2 1/2 :h 2/3 |
    } ending 1 {
      :q 3/2 5/2 :h (5/2 7/3) |
      :h (7/3[tie] 5/2[tie]) :q 3/2 1/2 |
      :q 1/2 2/3 :h 3/2 |
      :h 2/3 3/2 bar repeatEnd
    } ending 2 {
      :q 3/2 1/2 :h 2/3 |
      :w (3/2 2/3) bar final
    }
  }
  voice bass stem down tabStems on {
    repeatStart palmMute strings(6) { :w 0/6 |
    :h 0/6 0/5 |
    :w 0/6 |
    :h 0/6 0/5 |
    :w 3/6 |
    :h 0/6 0/5 |
    :w 0/6 |
    :h 0/6 0/5 |
    :w 3/6 |
    :w 0/6 } bar repeatEnd
    :h 0/6 skip |
    :w 0/6 bar final
  }
}
