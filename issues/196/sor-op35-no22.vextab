# Fernando Sor, Op. 35 No. 22, bars 1–8. Written as guitar frets in standard tuning.
# Adapted from Glen Larsen's Mutopia engraving of the N. Simrock edition, CC BY-SA 3.0.
# Edition: https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1850
# License: https://creativecommons.org/licenses/by-sa/3.0/
# Unspecified strings are editorial. The two melodic voices share some attacks in the source.
measureNumbers on
meter 3/4
guitar {
  key Bm
  voice melody stem up {
    :h 3/2[finger 2] :q 3/2 |
    :h 2/1[finger 1] :q 2/1 |
    :h 0/1[finger 0] :q 0/1 |
    :h 3/2[finger 2] :q 3/2 |
    :h 2/2[finger 1] :q 2/2 |
    :h 3/2[finger 2] :q 3/2 |
    :h 0/1[finger 0] :q 1/1[finger 1, write E#5] |
    :h 2/1[finger 1] :q 4/4 |
  }
  voice accompaniment stem down {
    :8 3/2 4/3[finger 4] 4/4[finger 3] 4/3 3/2 4/3 |
    2/1 3/2 4/4 3/2 2/1 3/2 |
    0/1 2/2[finger 1] 4/4 2/2 0/1 2/2 |
    3/2 4/3[finger 4] 4/4[finger 3] 4/3 3/2 4/3 |
    2/2 3/3[finger 2] 4/4[finger 3] 3/3 2/2 3/3 |
    3/2 4/3[finger 4] 4/4[finger 3] 4/3 3/2 4/3 |
    0/1[finger 0] 0/2[finger 0] 0/3[finger 0] 0/2 1/1[write E#5] 0/2 |
    2/1 2/2[finger 1] 3/3[finger 2] 2/2[finger 1] 4/4[finger 3] 3/3 |
  }
  voice bass stem down {
    :h. 2/5 | 2/5[tie] |
    :q skip :h 4/4 |
    :q skip :h 4/4 |
    :q skip :h 4/4 |
    :q skip :h 4/4 |
    :q skip :h 0/3 |
    :h. skip |
  }
}
