{
    "name": "vextab",
    "version": "6.2.2",
    "author": {
        "name": "Mohit Muthanna Cheppudira",
        "email": "mohit@muthanna.com",
        "url": "http://muthanna.com"
    },
    "main": "dist/main.prod.js",
    "description": "A VexTab Parser for VexFlow",
    "repository": {
        "type": "git",
        "url": "https://github.com/0xfe/vextab.git"
    },
    "license": "LicenseRef-LICENSE",
    "dependencies": {
        "vexflow": "5.9.0"
    },
    "devDependencies": {
        "@lahmatiy/jison": "0.4.18-remastered.7",
        "@vexflow-fonts/academico": "1.0.1",
        "@vexflow-fonts/bravura": "1.0.2",
        "@vexflow-fonts/petaluma": "1.0.1",
        "@vexflow-fonts/petalumascript": "1.0.0",
        "copy-webpack-plugin": "14.0.0",
        "css-loader": "7.1.5",
        "esbuild-loader": "4.5.0",
        "html-webpack-plugin": "5.6.8",
        "opentype.js": "1.3.4",
        "oxlint": "1.94.0",
        "playwright-core": "1.65.1",
        "prismjs": "1.30.0",
        "qunit": "3.0.0",
        "spessasynth_lib": "4.4.9",
        "style-loader": "4.0.0",
        "typescript": "7.0.2",
        "webpack": "5.112.2",
        "webpack-cli": "7.3.1",
        "webpack-dev-server": "6.1.0",
        "zepto-webpack": "1.2.1"
    },
    "bugs": {
        "url": "https://github.com/0xfe/vextab/issues"
    },
    "scripts": {
        "build": "tsc -p tsconfig.types.json && webpack --mode production --env TAG_NAME=prod",
        "guide:build": "webpack --mode production --env guideSite",
        "guide:upload": "node scripts/upload-guide.mjs",
        "build-dev": "webpack --mode development --env TAG_NAME=dev",
        "start": "webpack serve --mode development --env TAG_NAME=dev",
        "serve": "python3 -m http.server 8052 --bind 127.0.0.1",
        "watch": "webpack --watch --mode development --env TAG_NAME=dev",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "lint": "oxlint --deny-warnings src guide tests scripts tools webpack.config.js",
        "typecheck": "tsc --noEmit",
        "test:corpus": "node scripts/check-corpus.mjs && node scripts/test-migration.mjs",
        "migrate:score": "node scripts/migrate-score.mjs",
        "test": "npm run build-dev && npm run test:corpus && node scripts/test-browser.mjs",
        "test:vt6-baseline": "node issues/195/run.mjs",
        "test:baseline": "node scripts/test-baseline.mjs",
        "prepack": "npm run clean && npm run build-dev && npm run build",
        "report:setup": "npm ci --prefix tools --ignore-scripts",
        "report": "node tools/reports/cli.mjs build",
        "report:history": "node tools/reports/cli.mjs history",
        "report:upload": "node tools/reports/cli.mjs upload",
        "whatsnew:build": "node tools/whatsnew/build.mjs",
        "whatsnew:verify": "node tools/whatsnew/verify.mjs",
        "whatsnew:upload": "node tools/whatsnew/upload.mjs"
    },
    "homepage": "http://www.vexflow.com/vextab/",
    "keywords": [
        "music",
        "notation",
        "guitar",
        "tablature"
    ],
    "bin": { "vextab-migrate": "scripts/migrate-score.mjs" },
    "files": [
        "scripts/migrate-score.mjs",
        "dist",
        "src",
        "SECURITY.md"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "allowScripts": {
        "esbuild": false
    },
    "types": "dist/types/browser.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/browser.d.ts",
            "default": "./dist/main.prod.js"
        },
        "./browser": {
            "types": "./dist/types/browser.d.ts",
            "default": "./dist/browser.cjs"
        },
        "./performer": {
            "types": "./dist/types/playback/performer.d.ts",
            "default": "./dist/performer.cjs"
        },
        "./parse": {
            "types": "./dist/types/score/parse.d.ts",
            "default": "./dist/score.cjs"
        },
        "./auto": {
            "types": "./dist/types/auto.d.ts",
            "default": "./dist/div.prod.js"
        },
        "./*": "./*"
    }
}
