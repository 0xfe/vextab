{
    "name": "vextab",
    "version": "7.0.0",
    "author": {
        "name": "Mohit Muthanna Cheppudira",
        "email": "mohit@muthanna.com",
        "url": "http://muthanna.com"
    },
    "main": "./dist/runtime/auto.mjs",
    "jsdelivr": "./dist/runtime/vextab.js",
    "description": "A VexTab Parser for VexFlow",
    "repository": {
        "type": "git",
        "url": "https://github.com/0xfe/vextab.git"
    },
    "license": "LicenseRef-LICENSE",
    "dependencies": {
        "vexflow": "5.10.1"
    },
    "devDependencies": {
        "@lahmatiy/jison": "0.4.18-remastered.7",
        "@vexflow-fonts/academico": "1.0.1",
        "@vexflow-fonts/bravura": "1.0.2",
        "@vexflow-fonts/petaluma": "1.0.1",
        "@vexflow-fonts/petalumascript": "1.0.0",
        "copy-webpack-plugin": "14.0.0",
        "css-loader": "7.1.5",
        "esbuild": "0.28.2",
        "esbuild-loader": "4.5.0",
        "html-webpack-plugin": "5.6.8",
        "opentype.js": "2.0.0",
        "oxlint": "1.94.0",
        "playwright-core": "1.65.1",
        "prismjs": "1.30.0",
        "qunit": "3.0.0",
        "saxes": "6.0.0",
        "spessasynth_lib": "4.4.10",
        "style-loader": "4.0.0",
        "typescript": "7.0.2",
        "webpack": "5.113.0",
        "webpack-cli": "7.3.1",
        "webpack-dev-server": "6.1.0",
        "zepto-webpack": "1.2.1"
    },
    "bugs": {
        "url": "https://github.com/0xfe/vextab/issues"
    },
    "scripts": {
        "build": "npm run build:runtime && webpack --mode production --env TAG_NAME=prod",
        "test:import-guide": "npm run guide:build && node scripts/test-import-guide.mjs",
        "guide:build": "webpack --mode production --env guideSite",
        "guide:upload": "node scripts/upload-guide.mjs",
        "build-dev": "npm run build:runtime && webpack --mode development --env TAG_NAME=dev",
        "start": "webpack serve --mode development --env TAG_NAME=dev",
        "serve": "python3 -m http.server 8052 --bind 127.0.0.1",
        "watch": "webpack --watch --mode development --env TAG_NAME=dev",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "lint": "oxlint --deny-warnings src guide tests scripts tools webpack.config.js",
        "typecheck": "tsc --noEmit",
        "test:corpus": "node scripts/check-corpus.mjs && node scripts/test-migration.mjs",
        "migrate:score": "node scripts/migrate-score.mjs",
        "test": "npm run build-dev && npm run test:corpus && node scripts/test-browser.mjs",
        "test:vt6-baseline": "node issues/195/run.mjs",
        "test:baseline": "node scripts/test-baseline.mjs",
        "prepack": "npm run build:runtime",
        "report:setup": "npm ci --prefix tools --ignore-scripts",
        "report": "node tools/reports/cli.mjs build",
        "report:history": "node tools/reports/cli.mjs history",
        "report:upload": "node tools/reports/cli.mjs upload",
        "whatsnew:build": "node tools/whatsnew/build.mjs",
        "whatsnew:verify": "node tools/whatsnew/verify.mjs",
        "whatsnew:upload": "node tools/whatsnew/upload.mjs",
        "build:runtime": "node scripts/build-runtime.mjs"
    },
    "homepage": "http://www.vexflow.com/vextab/",
    "keywords": [
        "music",
        "notation",
        "guitar",
        "tablature"
    ],
    "bin": {
        "vextab-migrate": "scripts/migrate-score.mjs"
    },
    "files": [
        "dist/runtime/*.mjs",
        "dist/runtime/shared/*.mjs",
        "dist/runtime/import/*.mjs",
        "dist/runtime/vextab.js",
        "dist/runtime/vextab.css",
        "dist/runtime/types",
        "dist/runtime/THIRD-PARTY.txt",
        "dist/runtime/ZEPTO-LICENSE",
        "scripts/migrate-score.mjs",
        "SECURITY.md"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "allowScripts": {
        "esbuild": false
    },
    "types": "./dist/runtime/types/auto.d.ts",
    "exports": {
        ".": {
            "types": "./dist/runtime/types/auto.d.ts",
            "default": "./dist/runtime/auto.mjs"
        },
        "./auto": {
            "types": "./dist/runtime/types/auto.d.ts",
            "default": "./dist/runtime/auto.mjs"
        },
        "./browser": {
            "types": "./dist/runtime/types/browser.d.ts",
            "default": "./dist/runtime/browser.mjs"
        },
        "./parse": {
            "types": "./dist/runtime/types/score/parse.d.ts",
            "default": "./dist/runtime/parse.mjs"
        },
        "./performer": {
            "types": "./dist/runtime/types/playback/performer.d.ts",
            "default": "./dist/runtime/performer.mjs"
        },
        "./import/musicxml": {
            "types": "./dist/runtime/types/import/musicxml.d.ts",
            "default": "./dist/runtime/import/musicxml.mjs"
        },
        "./import/mxl": {
            "types": "./dist/runtime/types/import/mxl.d.ts",
            "default": "./dist/runtime/import/mxl.mjs"
        },
        "./import/lilypond": {
            "types": "./dist/runtime/types/import/lilypond.d.ts",
            "default": "./dist/runtime/import/lilypond.mjs"
        },
        "./vextab.css": "./dist/runtime/vextab.css",
        "./package.json": "./package.json"
    }
}
